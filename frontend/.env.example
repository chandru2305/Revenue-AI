# Copy to .env.local for local development. Never commit a real .env file.
VITE_API_BASE_URL=http://localhost:8000

# Sent as X-API-Key. Must match the backend's API_KEY. Leave empty when the
# backend has no API_KEY set (the local-development default).
#
# NOTE: this value is compiled into the JavaScript bundle and is readable
# by anyone who opens browser devtools. It gates access to a deployment;
# it is not a user credential and is not a secret. See docs/security.md.
VITE_API_KEY=
