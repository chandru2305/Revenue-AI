# RecoverAI environment configuration
# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file.

# --- Application ---
APP_ENV=development
APP_NAME=RecoverAI
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- CORS ---
# Comma-separated list of allowed origins for the frontend dev server.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- API authentication ---
# Shared key required as an `X-API-Key` header on every /api/v1 endpoint.
# Empty (the default) means auth is NOT enforced — convenient for local
# development, and the app logs a warning at startup saying so.
# With APP_ENV=production, an empty value makes the app refuse to start
# rather than silently serve an unauthenticated API.
# /health and POST /api/v1/webhooks/razorpay are deliberately exempt: the
# former is an infrastructure probe, the latter authenticates by HMAC
# signature instead (Razorpay cannot send this key).
# The frontend must be built with a matching VITE_API_KEY.
API_KEY=

# --- Database ---
# PostgreSQL is the source-of-truth architecture.
DATABASE_URL=postgresql+asyncpg://recoverai:recoverai@localhost:5432/recoverai
# Optional local-only fallback (SQLite) for contributors without Docker.
# DATABASE_URL=sqlite+aiosqlite:///./recoverai.db

# --- Razorpay (Test Mode execution, as of Phase 3 — see docs/razorpay-integration.md) ---
# Test Mode keys only. Never place Live Mode keys here. If empty, every
# execute call gracefully escalates instead of crashing (see
# docs/razorpay-integration.md "Provider abstraction").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay Dashboard's webhook configuration for this endpoint's
# URL (POST /api/v1/webhooks/razorpay). If empty, signature verification
# always fails closed — every webhook is rejected, none are trusted.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# MUST stay "test" in this repo — RazorpayPaymentProvider refuses to
# construct otherwise (not bypassable).
RAZORPAY_MODE=test
RAZORPAY_REQUEST_TIMEOUT_SECONDS=15
RAZORPAY_MAX_RETRIES=1
# How long a created Payment Link stays valid before it's treated as
# expired for recovery purposes.
RECOVERY_PAYMENT_LINK_EXPIRY_HOURS=72

AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=1

# --- LLM Provider: Groq (chat-completions, OpenAI-compatible) ---
# Get a key at https://console.groq.com/keys. If empty, AI diagnosis
# gracefully falls back to ESCALATE on every call instead of crashing —
# see docs/ai-safety.md.
GROQ_API_KEY=
# Pinned rather than a floating alias: the model name is recorded on
# every AI audit event, so a moving target would make a past decision
# unreproducible. Verified live 1 Sep 2026 (chat-completions + json_object).
GROQ_MODEL=openai/gpt-oss-120b


# --- Autonomous recovery loop (app/services/orchestrator_service.py) ---
# Run discover -> diagnose -> (optionally) execute cycles in the background.
# OFF by default: a dev server, a test run, and `make up` must never start
# making provider calls on their own. POST /api/v1/orchestrator/cycle works
# regardless, for an operator-triggered pass.
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_INTERVAL_SECONDS=300
# SAFETY: executing moves money. Diagnosis (reasoning + a policy decision)
# is safe to automate; execution is opt-in and defaults OFF, leaving
# approved cases for a human. Turning this on does NOT bypass any policy
# rule — execution still re-checks policy with fresh data first.
ORCHESTRATOR_AUTO_EXECUTE=false
# Per-cycle budgets, so a large backlog drains gradually instead of firing
# hundreds of provider calls at once.
ORCHESTRATOR_MAX_DISCOVER=100
ORCHESTRATOR_MAX_DIAGNOSE=25
ORCHESTRATOR_MAX_EXECUTE=10

# --- Policy Engine (defaults; can be overridden per-environment) ---
POLICY_MAX_RETRY_COUNT=3
POLICY_MAX_RECOVERY_WINDOW_DAYS=14
POLICY_MAX_CUSTOMER_CONTACTS=2
POLICY_MIN_CONFIDENCE_THRESHOLD=0.55
# Payments at or above this amount must clear the higher confidence bar
# below before any recovery action is permitted.
POLICY_HIGH_VALUE_AMOUNT_THRESHOLD=500000
POLICY_HIGH_VALUE_MIN_CONFIDENCE_THRESHOLD=0.75
# Hard ceiling on what a single recovery may ever pursue, in the smallest
# currency unit. A payment above this is blocked with
# AMOUNT_OUT_OF_BOUNDS regardless of AI confidence — the guard against a
# corrupted or mis-ingested amount reaching the provider. Raise it
# deliberately, never to make one case go through.
POLICY_MAX_RECOVERY_AMOUNT=10000000
